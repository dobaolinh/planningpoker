<mxfile host="app.diagrams.net">
  <diagram name="1.1 Tong quan luong" id="flow-1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="c0" value="&lt;b&gt;Khách hàng của Schaeffler&lt;/b&gt;&lt;br&gt;Đơn đặt hàng + Yêu cầu tài liệu (Documentation Requirements)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="480" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;GIAI ĐOẠN 1: Tiếp nhận và phân tích yêu cầu&lt;/b&gt;&lt;br&gt;Đọc PO/spec khách → lập Document Matrix (danh mục tài liệu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="150" y="120" width="480" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;GIAI ĐOẠN 2: Thu thập dữ liệu đa phòng ban&lt;/b&gt;&lt;br&gt;R&amp;amp;D/Engineering │ Procurement │ Production │ Quality │ Service │ Logistics │ Compliance/EHS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="150" y="230" width="480" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;GIAI ĐOẠN 3: Soạn thảo theo template&lt;/b&gt;&lt;br&gt;Điền template chuẩn + gắn bản vẽ/chứng chỉ/báo cáo test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="150" y="360" width="480" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="s4" value="&lt;b&gt;GIAI ĐOẠN 4: Rà soát và phê duyệt&lt;/b&gt;&lt;br&gt;Peer review → Quality check → Manager approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="150" y="470" width="480" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="s5" value="&lt;b&gt;GIAI ĐOẠN 5: Bàn giao (Handover)&lt;/b&gt;&lt;br&gt;Đóng gói Technical Documentation Package → gửi khách" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="150" y="580" width="480" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="s6" value="&lt;b&gt;GIAI ĐOẠN 6: Nghiệm thu và chứng nhận&lt;/b&gt;&lt;br&gt;Đối chiếu checklist FAT/SAT/Installation → xuất văn bản chứng nhận (Acceptance, Conformity, Training...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="150" y="690" width="480" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="s7" value="&lt;b&gt;GIAI ĐOẠN 7: Lưu trữ và quản lý thay đổi&lt;/b&gt;&lt;br&gt;Archive, version, change request, cập nhật sau bàn giao" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="150" y="810" width="480" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="g1" value="Gate 1&lt;br&gt;Xác nhận Matrix" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="130" width="110" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="Gate 2&lt;br&gt;Dữ liệu đủ, đúng bản" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="250" width="110" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="Gate 3&lt;br&gt;Review KT + chất lượng" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="460" width="110" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="g4" value="Gate 4&lt;br&gt;Manager phê duyệt" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="510" width="110" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="g5" value="Gate 5&lt;br&gt;Đối chiếu checklist rồi mới phát hành chứng nhận" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="10" y="700" width="110" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
