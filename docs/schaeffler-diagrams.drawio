        <mxCell id="a1" value="&lt;b&gt;① Intake Agent&lt;/b&gt;&lt;br&gt;PO/spec → Document Matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="230" height="55" as="geometry"/></mxCell>
        <mxCell id="a2" value="&lt;b&gt;② Data Collector Agent&lt;/b&gt;&lt;br&gt;Thu thập dữ liệu, báo thiếu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="300" width="230" height="55" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;b&gt;③ Drafting Agent&lt;/b&gt;&lt;br&gt;Điền template, sinh nháp + nguồn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="230" height="55" as="geometry"/></mxCell>
        <mxCell id="a4" value="&lt;b&gt;④ Validation Agent&lt;/b&gt;&lt;br&gt;Kiểm tra chéo spec/BOM/tiêu chuẩn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="810" y="300" width="230" height="55" as="geometry"/></mxCell>
        <mxCell id="a5" value="&lt;b&gt;⑤ Review Router&lt;/b&gt;&lt;br&gt;Chuyển duyệt, audit trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="230" height="55" as="geometry"/></mxCell>
        <mxCell id="a6" value="&lt;b&gt;⑥ Handover Agent&lt;/b&gt;&lt;br&gt;Đóng gói, gửi, theo dõi xác nhận" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="370" width="230" height="55" as="geometry"/></mxCell>
