        <mxCell id="gl1" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#b85450;" edge="1" parent="1" source="g1" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gl2" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#b85450;" edge="1" parent="1" source="g2" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gl3" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#b85450;" edge="1" parent="1" source="g3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gl4" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#b85450;" edge="1" parent="1" source="g4" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gl5" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#b85450;" edge="1" parent="1" source="g5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
