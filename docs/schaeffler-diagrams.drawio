        <mxCell id="u4" value="Manager (phê duyệt / ký)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="810" y="60" width="230" height="45" as="geometry"/></mxCell>

        <mxCell id="L2" value="&lt;b&gt;ORCHESTRATOR AGENT&lt;/b&gt;&lt;br&gt;Điều phối workflow, quản lý state, SLA, escalation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="1020" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="L3" value="&lt;b&gt;LỚP AGENT CHUYÊN BIỆT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="265" width="1020" height="175" as="geometry"/>
