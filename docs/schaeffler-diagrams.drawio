  <diagram name="2.2 Kien truc AI Agent" id="arch-1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="L1" value="&lt;b&gt;LỚP NGƯỜI DÙNG&lt;/b&gt; (Portal / Chat / Teams / Email – Human-in-the-loop dashboard)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1020" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="u1" value="Doc Manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="230" height="45" as="geometry"/></mxCell>
        <mxCell id="u2" value="Engineer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="310" y="60" width="230" height="45" as="geometry"/></mxCell>
